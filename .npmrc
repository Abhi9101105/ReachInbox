# Always install devDependencies even when NODE_ENV=production.
# Render (and other CI platforms) set NODE_ENV=production before running npm ci,
# which causes npm to omit devDependencies. However, this monorepo's build step
# requires dev tools (TypeScript, tsx, Prisma CLI, rimraf) that live in
# devDependencies. Setting include=dev ensures npm ci always installs them.
include=dev
